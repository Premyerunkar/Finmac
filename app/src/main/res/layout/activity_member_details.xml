<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Navy Corporate Placard -->
    <LinearLayout
        android:id="@+id/headerPlacard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#052550"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/abc_ic_ab_back_material"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="MEMBER DIRECTORY"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddNewMember"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#1E40AF"
                android:paddingHorizontal="12dp"
                android:text="+ Add Member"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:cornerRadius="8dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LOADING SOCIETY..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHeaderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Address: Syncing physical coordinates..."
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Total Registered Members Pill Badge -->
        <TextView
            android:id="@+id/txtTotalMembersCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="#1E3A8A"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="Total Registered Members: 0"
            android:textColor="#E0F2FE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search & Order Controls Bar -->
    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerPlacard"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#052550"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#052550">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeckSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search by Flat No or Member Name..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingVertical="0dp"
                android:textColor="#0F172A"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_spinner_outlined">

            <Spinner
                android:id="@+id/cmbSortOrder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main Cards Grid Display Deck -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCardsGridDeck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/controlsBar"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Shimmer Loader Container -->
    <FrameLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/controlsBar"
        android:background="#F8FAFC"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <include layout="@layout/layout_shimmer_member_list" />
    </FrameLayout>
</RelativeLayout>