<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Branch & Invoice -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtAuditInvoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EFF6FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="#R26-0001 (B001)"
                android:textColor="#1E40AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAuditTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="2026-10-16 19:42:00"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- User Identity -->
        <TextView
            android:id="@+id/txtAuditUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="👤 Modified By: Prem (SuperAdmin)"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Reason Note Box -->
        <TextView
            android:id="@+id/txtAuditReasonNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FEF3C7"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="✏️ Modification Reason Note: Corrected category allocation per board instructions."
            android:textColor="#92400E"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>