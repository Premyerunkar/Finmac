<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Navy Top Accent Bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="#052550" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/lblVendorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="VENDOR NAME"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblVendorCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Code: --"
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lblAccountHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Head: --"
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lblContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Contact: --"
                android:textColor="#374151"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lblPan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PAN: --"
                android:textColor="#6B7280"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/lblAadhaar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Aadhaar Identity: [Aadhaar Redacted]"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:textStyle="italic" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>