<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/txtRowDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="2026-06-04"
        android:textColor="#475569"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtRowInvoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="0001"
        android:textColor="#991B1B"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRowVendorCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="N/A"
        android:textColor="#1E293B"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtRowVendorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Omkar Ingale"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRowCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Electricity..."
        android:textColor="#475569"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtRowCashDb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="end"
        android:text="₹0.00"
        android:textColor="#DC2626"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRowBankDb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="end"
        android:text="₹1,000.00"
        android:textColor="#0284C7"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        android:rotation="180"
        android:src="@drawable/abc_ic_ab_back_material"
        app:tint="#94A3B8" />

</LinearLayout>