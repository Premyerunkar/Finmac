<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Top Navy Header Banner -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#052550"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblFullViewSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statement Registry"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblFullViewSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Total Records: 0 | Total Value: ₹0.00"
                android:textColor="#93C5FD"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseFullViewSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Top Action Deck: Search & Export Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="#052550"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#052550">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtFullViewSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search statement records..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingVertical="0dp"
                android:textColor="#0F172A"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullExportPdf"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="📄 PDF"
            android:textColor="#052550"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:strokeColor="#052550"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullExportCsv"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="📊 CSV"
            android:textColor="#16A34A"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:strokeColor="#16A34A"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Structured Table Header for Full Statement View -->
    <LinearLayout
        android:id="@+id/containerFullTableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/lblColDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Date"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColVoucher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="Voucher #"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColEntity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ref Code"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColParty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:text="Party Name"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:text="Category"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColCash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="end"
            android:text="Cash"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblColBank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="end"
            android:text="Bank"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="18dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Full Statement RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFullStatementTable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_cashbook_receipt_row" />

</LinearLayout>